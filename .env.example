# development | production (production refuses weak/default secrets)
APP_ENV=development

# HTTP listen address
HTTP_ADDR=:8080

# PostgreSQL connection string
DATABASE_URL=postgres://waf:waf@localhost:5432/waf?sslmode=disable

# JWT (HS256) — production: required, != development default, >= 32 chars
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRE_HOURS=24

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Seed admin on first boot (only if no admin user exists)
# Production: required, != Admin@123, >= 12 chars. Do NOT reuse compose defaults.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# Comma-separated CIDRs trusted to set X-Forwarded-For / X-Real-IP
TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8

# Swagger: development default on; production default off unless true
# SWAGGER_ENABLED=true

# Max JSON body size in bytes (default 1048576 = 1MiB)
# MAX_BODY_BYTES=1048576
