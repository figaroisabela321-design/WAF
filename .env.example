# HTTP listen address
HTTP_ADDR=:8080

# PostgreSQL connection string
DATABASE_URL=postgres://waf:waf@localhost:5432/waf?sslmode=disable

# JWT (HS256)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=24

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Seed admin on first boot (only if no admin user exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
